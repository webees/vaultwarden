# ╔═══════════════════════════════════════════════════════════════════════════╗
# ║ Caddy Reverse Proxy                                                       ║
# ╚═══════════════════════════════════════════════════════════════════════════╝

# ── Global Options ────────────────────────────────────────────────────────────
{
	auto_https off
	admin off
	persist_config off

	# Trust Fly.io private networking for accurate IP parsing
	servers {
		trusted_proxies static private_ranges
		client_ip_headers Fly-Client-IP
	}

	log {
		level INFO
		output stdout
		format console
	}
}

# ── Site Block ────────────────────────────────────────────────────────────────
:8080 {
	encode zstd gzip

	# Access log (one line per request, written to stdout)
	log {
		output stdout
		format filter {
			wrap console
			fields {
				request>headers>Authorization delete
				request>headers>Cookie delete
				request>headers>Proxy-Authorization delete
				request>headers>X-Api-Key delete
				request>headers>X-Auth-Token delete
				request>headers>X-Backup-Status-Token delete
				request>headers>CF-Access-Jwt-Assertion delete
			}
		}
	}

	# Harden security posture
	header {
		Strict-Transport-Security "max-age=31536000;"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Robots-Tag "noindex, nofollow"
		-Server
		-X-Powered-By
		-Last-Modified
	}

	route {
		# Always allow health checks bypass for Fly.io monitoring
		@alive path /alive
		handle @alive {
			reverse_proxy 127.0.0.1:8081
		}

		# Domain Access Control (deny by default when CADDY_DOMAINS is unset)
		@denied not host {$CADDY_DOMAINS:localhost}
		handle @denied {
			respond "Access Denied: Domain not allowed" 403
		}

		# Backup freshness endpoint for the external watchdog. The token is a Fly
		# secret; unauthenticated requests get 404 instead of leaking status.
		@backup_status path /backup-status
		handle @backup_status {
			@backup_status_authorized header X-Backup-Status-Token {$LEGACY_MONITOR_TOKEN:__unset__}
			handle @backup_status_authorized {
				root * /data
				rewrite * /backup-status.txt
				file_server
			}
			respond "Not found" 404
		}

		# Cloudflare publishes origin-facing ranges. Fly overwrites Fly-Client-IP
		# at the edge, so a direct client cannot impersonate one; only then is
		# CF-Connecting-IP trusted.
		@via_cloudflare {
			import /cloudflare-ips.caddy
			header CF-Connecting-IP *
		}
		handle @via_cloudflare {
			reverse_proxy 127.0.0.1:8081 {
				header_up X-Real-IP {http.request.header.CF-Connecting-IP}
				header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			}
		}

		handle {
			reverse_proxy 127.0.0.1:8081 {
				header_up X-Real-IP {http.request.header.Fly-Client-IP}
				header_up X-Forwarded-For {http.request.header.Fly-Client-IP}
			}
		}
	}
}
