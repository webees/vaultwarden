# Local template only. Copy it and fill in real values for a local run:
#   cp .env.example .env
#
# Production values live in Fly secrets (`fly secrets set`). Never commit .env,
# and never put a real credential in this file.

###################
# Domain allowlist #
###################

# Requests whose Host header is not listed here get 403.
# Multiple domains: "example.com example.org". Unset falls back to localhost.
CADDY_DOMAINS=

#########################################################
# E-mail settings                                        #
#                                                        #
# Vaultwarden uses these for its own mail (invitations,  #
# password resets). SMTP_TO is only the recipient of the #
# monthly integrity check's alert email: every hourly    #
# alert goes to Telegram instead.                        #
#########################################################

SMTP_FROM=from@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Recipient of the monthly `verify` email. Leave it unset to send no email.
SMTP_TO=to@example.com

# Seconds msmtp may wait for the relay before the alert is abandoned.
SMTP_TIMEOUT=15

# Optional Telegram notifications. Set both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

####################
# Restic settings  #
####################

# Initialised automatically by the first backup run.
RESTIC_REPOSITORY=s3://your-account-id.r2.cloudflarestorage.com/vaultwarden
RESTIC_PASSWORD=your-restic-password

# S3-compatible storage credentials (R2, B2, Wasabi, Minio, ...)
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional dead-man's-switch, pinged after every backup run.
HEALTHCHECK_URL=

# Notify on Telegram after every successful backup. Opt-in to avoid hourly noise.
BACKUP_NOTIFY_ON_SUCCESS=false

# Optional tuning (defaults shown). Values must be canonical positive integers;
# the limits are rejected before any log maintenance or backend command starts.
# RESTIC_LOG_MAX_BYTES must not exceed RESTIC_LOG_DIR_MAX_BYTES.
BACKUP_MAX_AGE=7200
BACKUP_MAX_USAGE_PERCENT=85
RESTIC_LOG_DIR=/data/restic-logs
RESTIC_LOG_MAX_BYTES=262144
RESTIC_LOG_DIR_MAX_BYTES=10485760
RESTIC_QUICK_TIMEOUT=60
RESTIC_LONG_TIMEOUT=1800
VERIFY_SUBSET=10%
VERIFY_RETRY_LOCK=10m
SUPERVISE_RESTART_DELAY=5

########################
# Vaultwarden settings #
########################

# Full URL with protocol required.
DOMAIN=https://vault.example.com

# Disable new user registration.
SIGNUPS_ALLOWED=false

# Comma separated list of users allowed to create organisations.
ORG_CREATION_USERS=admin@example.com

# Hide password hints; see the Vaultwarden hardening guide.
SHOW_PASSWORD_HINT=false

# Admin panel token. Leave unset unless /admin must be reachable.
# ADMIN_TOKEN=
