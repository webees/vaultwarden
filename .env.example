# Local template. Copy to .env, fill real values, and never commit it.
# Production values belong in Fly secrets.

# Space-separated Host allowlist. Unset falls back to localhost.
CADDY_DOMAINS=vault.example.com

# Vaultwarden mail: invitations and password resets.
SMTP_FROM=from@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password

# Monthly verification and restore-drill recipient. Optional.
SMTP_TO=to@example.com
SMTP_TIMEOUT=15

# Hourly operational alerts. Set both or neither.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Restic repository and S3-compatible credentials.
RESTIC_REPOSITORY=s3://your-account-id.r2.cloudflarestorage.com/vaultwarden
RESTIC_PASSWORD=your-restic-password
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Optional dead-man's switch. Failures use <HEALTHCHECK_URL>/fail.
HEALTHCHECK_URL=

# Backup guards and bounded command limits.
BACKUP_MAX_AGE=7200
BACKUP_MAX_USAGE_PERCENT=85
RESTIC_LOG_DIR=/data/restic-logs
RESTIC_LOG_MAX_BYTES=262144
RESTIC_LOG_DIR_MAX_BYTES=10485760
RESTIC_QUICK_TIMEOUT=60
RESTIC_LONG_TIMEOUT=1800
VERIFY_SUBSET=10%
VERIFY_RETRY_LOCK=10m
SUPERVISE_RESTART_DELAY=5

# Vaultwarden settings.
DOMAIN=https://vault.example.com
SIGNUPS_ALLOWED=false
ORG_CREATION_USERS=admin@example.com
SHOW_PASSWORD_HINT=false
# ADMIN_TOKEN=
